{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/scanner",
        "destination": "/scanner.html"
      },
      {
        "source": "/ticket/**",
        "destination": "/ticket.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
